# =============================================================================
# pscale-async — environment template
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
# Variables marked REQUIRED fail fast with a clear error when unset.
# =============================================================================

# --- Database (required by the API and workers) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/log_intelligence

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# --- Auth bootstrap (REQUIRED — the API refuses to start without these) ---
# There are no default credentials. Generate a bcrypt hash for your admin
# password with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# --- JWT signing ---
# If SECRET_KEY is unset, the API generates an ephemeral per-process key
# (tokens do NOT survive restarts — safe default, but set a stable SECRET_KEY
# in production so logins persist across deploys).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- OneFS cluster (REQUIRED for real-cluster features; fail fast when unset) ---
# For local development without a cluster: ONEFS_MOCK_MODE=true
ONEFS_MOCK_MODE=false
ONEFS_HOST=
ONEFS_SSH_PORT=22
ONEFS_API_PORT=8080
ONEFS_USER=
ONEFS_PASS=
ONEFS_SSH_KEY_PATH=~/.ssh/id_rsa

# Base directory on the cluster that remote log reads are confined to.
# /api/v1/ingest/cluster rejects any log_path outside this directory.
ONEFS_LOG_DIR=/var/log

# --- OneFS SSH host-key verification ---
# Base64-encoded raw host key blob for the cluster:
#   ssh-keyscan -t ed25519 "$ONEFS_HOST" | awk '{print $3}'
# If unset, ~/.ssh/known_hosts is used. Unknown hosts are ALWAYS rejected
# (RejectPolicy) — there is no AutoAddPolicy / StrictHostKeyChecking=no path.
ONEFS_HOST_KEY=
ONEFS_HOST_KEY_TYPE=ssh-ed25519

# --- Legacy tunnel aliases (prefer ONEFS_HOST / ONEFS_USER; also fail fast) ---
CLUSTER_HOST=
CLUSTER_PORT=22
ISILON_HOST=localhost
ISILON_PORT=8080
ISILON_USER=
ISILON_PASS=

# --- Compose ---
# Postgres password for the compose-managed database (dev default shown).
POSTGRES_PASSWORD=postgres

# --- Log processing ---
MAX_FILE_SIZE_MB=2048
CHUNK_SIZE=8192
PATTERN_LIBRARY_PATH=./patterns/

# --- Upload object storage (API -> Celery handoff) ---
# The API streams multipart uploads into this backend and hands the worker
# a content reference (backend + bucket + key) — never a local path.
#   local: plain files under LOCAL_UPLOAD_DIR (dev/tests; API and worker
#          must share the filesystem).
#   s3:    any S3-compatible endpoint via boto3 (MinIO in compose, AWS S3
#          in prod). REQUIRED vars below fail fast when unset.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pscale-async-uploads
S3_REGION=us-east-1

# --- MinIO (docker compose object storage) ---
# Root credentials for the compose-managed MinIO. Override in production;
# never commit real values. Console: http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# --- Chunked pipeline (Celery group + chord fan-out) ---
# Lines of log per worker chunk. Smaller = more parallelism but more
# object reads (each chunk re-streams the upload to reach its slice).
CHUNK_LINES=10000
